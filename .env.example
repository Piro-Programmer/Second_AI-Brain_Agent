# Groq — https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional: override models when Groq retires one (see console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Database. Leave empty locally to use data/secondself.db (SQLite).
# On Streamlit Cloud use Supabase's "Session pooler" connection string (IPv4).
DATABASE_URL=

# Optional: fixed secret for login cookies (generated and stored in the database if empty)
AUTH_COOKIE_KEY=

# Email for "Forgot password" codes, e.g. Gmail with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=SecondSelf <you@gmail.com>
