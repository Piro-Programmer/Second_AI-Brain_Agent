# Groq — https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional: override models when Groq retires one (see console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional: fixed secret for login cookies (any long random string)
AUTH_COOKIE_KEY=change_me_to_a_long_random_string
